// =====================================================================
// G-1 experiment 2 — Prisma datamodel
//
// Experiment 1 (see ../sql/, ../prisma/, ../expected/ci-evidence.md) built
// the schema by hand and asked Prisma what it thought of it. That question
// was answered — and it was the wrong question, because a hand-built schema
// has no migration history, so Prisma proposed rebuilding everything.
//
// Experiment 2 asks the question production actually faces:
//
//   Can the five approved composite FKs survive when the schema is created
//   BY PRISMA (so migration history exists) and they are appended to a
//   Prisma-generated migration file?
//
// ---------------------------------------------------------------------
// Design rule: this datamodel declares EVERY object that Prisma is able to
// express, including the three support unique keys that C-1..C-3 reference.
// That is deliberate and it is what makes the result interpretable.
//
// In experiment 1 the support uniques and the composite FKs were both
// undeclared, so the diff could not distinguish "Prisma drops things it
// cannot model" from "Prisma drops things the datamodel forgot". Here the
// support keys ARE modelled, so any residual difference must be one of the
// two objects Prisma genuinely cannot express:
//
//   * the five composite foreign keys C-1..C-5   -> appended by hand
//   * the active-only partial index uq_topics_chapter_order (E-7, rev. 5)
//                                                  -> appended by hand
//
// The support keys are modelled with an explicit `map:` so that they carry
// their APPROVED NAMES (uq_chapters_id_subject, ...) rather than Prisma's
// generated names. Their definitions are not altered in any way: a unique
// index on the same columns serves as the referenced key for a composite FK
// exactly as a unique constraint does.
//
// SPIKE ONLY. This is not prisma/schema.prisma and must never be adopted
// as the project schema without a fresh review.
// =====================================================================

generator client {
  provider = "prisma-client"
  output   = "./generated"
}

// Prisma 7 does not read a datasource `url` from the schema: it comes from
// `--url` or from the `datasource` block of the Prisma config, which this
// experiment generates at run time. Keeping a url here would be ignored.
datasource db {
  provider = "postgresql"
}

model EducationLevel {
  id            String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code          String         @unique
  levelSubjects LevelSubject[]
  questions     Question[]

  @@map("education_levels")
}

model Subject {
  id            String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code          String         @unique
  levelSubjects LevelSubject[]
  chapters      Chapter[]
  questions     Question[]

  @@map("subjects")
}

// C-1's referenced key is this table's composite PRIMARY KEY — Prisma models
// it natively, so nothing here is hand-written.
model LevelSubject {
  levelId   String         @map("level_id") @db.Uuid
  subjectId String         @map("subject_id") @db.Uuid
  level     EducationLevel @relation(fields: [levelId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  subject   Subject        @relation(fields: [subjectId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@id([levelId, subjectId])
  @@map("level_subjects")
}

model Chapter {
  id            String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  subjectId     String     @map("subject_id") @db.Uuid
  chapterNumber Int        @map("chapter_number")
  titleEn       String     @default("") @map("title_en")
  isActive      Boolean    @default(true) @map("is_active")
  subject       Subject    @relation(fields: [subjectId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  topics        Topic[]
  questions     Question[]

  // E-7 (rev. 5): plain global unique. Prisma-native.
  @@unique([subjectId, chapterNumber], map: "uq_chapters_subject_number")
  // C-2's support key. Expressible natively, so it is NOT hand-written.
  @@unique([id, subjectId], map: "uq_chapters_id_subject")
  @@map("chapters")
}

model Topic {
  id         String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  chapterId  String     @map("chapter_id") @db.Uuid
  nameEn     String     @default("") @map("name_en")
  orderIndex Int        @default(0) @map("order_index")
  isActive   Boolean    @default(true) @map("is_active")
  chapter    Chapter    @relation(fields: [chapterId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  subtopics  Subtopic[]
  questions  Question[]

  // C-3's support key. Expressible natively.
  @@unique([id, chapterId], map: "uq_topics_id_chapter")
  // E-7 as corrected in rev. 5: display order is ACTIVE-ONLY unique, expressed
  // by the hand-written partial index uq_topics_chapter_order. Prisma cannot
  // model a partial index, so it is deliberately absent here and is appended
  // to the generated migration by manual/001_composite_fks.sql.
  @@map("topics")
}

model Subtopic {
  id      String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  topicId String     @map("topic_id") @db.Uuid
  nameEn  String     @default("") @map("name_en")
  topic   Topic      @relation(fields: [topicId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  questions Question[]

  // C-4's support key. Expressible natively.
  @@unique([id, topicId], map: "uq_subtopics_id_topic")
  @@map("subtopics")
}

model Question {
  id               String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  educationLevelId String         @map("education_level_id") @db.Uuid
  subjectId        String         @map("subject_id") @db.Uuid
  chapterId        String?        @map("chapter_id") @db.Uuid
  topicId          String?        @map("topic_id") @db.Uuid
  subtopicId       String?        @map("subtopic_id") @db.Uuid
  educationLevel   EducationLevel @relation(fields: [educationLevelId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  subject          Subject        @relation(fields: [subjectId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  chapter          Chapter?       @relation(fields: [chapterId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  topic            Topic?         @relation(fields: [topicId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  subtopic         Subtopic?      @relation(fields: [subtopicId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  versions         QuestionVersion[]

  // The two chain CHECKs that make C-2/C-3/C-4 meaningful. A CHECK is
  // expressible in Prisma 7 only as schema raw SQL, so they are appended to
  // the generated migration alongside the composite FKs.
  @@map("questions")
}

model QuestionVersion {
  id         String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  questionId String           @map("question_id") @db.Uuid
  question   Question         @relation(fields: [questionId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  options    QuestionOption[]
  answerKeys AnswerKey[]

  @@map("question_versions")
}

model QuestionOption {
  id        String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  versionId String          @map("version_id") @db.Uuid
  key       String
  version   QuestionVersion @relation(fields: [versionId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  // C-5's referenced key. Expressible natively.
  @@unique([versionId, key], map: "uq_question_options_version_key")
  @@map("question_options")
}

model AnswerKey {
  id                  String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  versionId           String          @map("version_id") @db.Uuid
  mcqCorrectOptionKey String?         @map("mcq_correct_option_key")
  version             QuestionVersion @relation(fields: [versionId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([versionId], map: "uq_answer_keys_version")
  // NOTE: the (versionId, mcqCorrectOptionKey) -> QuestionOption relation is
  // NOT modelled. It is composite FK C-5 and is appended by hand.
  @@map("answer_keys")
}
