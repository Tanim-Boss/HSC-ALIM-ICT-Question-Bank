{
  "$description": "ICT Atlas design-token mirror for Design Production Phases 1–2. Locked decisions are governed by README.md §17; this file is the machine-readable handoff and must remain in sync with that source. Do not add palette values in implementation.",
  "color": {
    "palette": {
      "light": {
        "canvas": { "$type": "color", "$value": "#FAFAFA" },
        "surface": { "$type": "color", "$value": "#FFFFFF" },
        "ink": { "$type": "color", "$value": "#17191B" },
        "muted": { "$type": "color", "$value": "#777D83" },
        "mutedStrong": { "$type": "color", "$value": "#6B7076" },
        "border": { "$type": "color", "$value": "#E8EAEC" },
        "teal": { "$type": "color", "$value": "#16766B" },
        "tealTint": { "$type": "color", "$value": "#E7F3EF" },
        "amber": { "$type": "color", "$value": "#B77C2B" },
        "red": { "$type": "color", "$value": "#B6534C" }
      },
      "dark": {
        "canvas": { "$type": "color", "$value": "#090B0D" },
        "surface": { "$type": "color", "$value": "#111416" },
        "ink": { "$type": "color", "$value": "#F2F4F5" },
        "muted": { "$type": "color", "$value": "#8B949C" },
        "border": { "$type": "color", "$value": "#293137" },
        "teal": { "$type": "color", "$value": "#55B8A5" },
        "tealTint": { "$type": "color", "$value": "#203C36" },
        "amber": { "$type": "color", "$value": "#D9A857" },
        "red": { "$type": "color", "$value": "#E0877F" }
      },
      "shared": {
        "elevated": {
          "$type": "color",
          "$value": "#1B2024",
          "$description": "The approved Elevated/code surface. In light theme, reserve this dark surface for code/terminal content or an explicitly specified dark treatment; do not use it as the generic raised light surface."
        },
        "accent": { "$type": "color", "$value": "#D9E8AE", "$extensions": { "ictAtlas": { "cssVariable": "--accent", "tailwindClass": "bg-accent" } } },
        "codeInk": { "$type": "color", "$value": "#F2F4F5", "$extensions": { "ictAtlas": { "cssVariable": "--code-ink", "tailwindClass": "text-code-ink" } } }
      }
    },
    "semantic": {
      "light": {
        "background": {
          "canvas": {
            "$type": "color",
            "$value": "{color.palette.light.canvas}",
            "$description": "Default page background.",
            "$extensions": { "ictAtlas": { "cssVariable": "--canvas", "tailwindClass": "bg-canvas" } }
          },
          "surface": {
            "$type": "color",
            "$value": "{color.palette.light.surface}",
            "$description": "Cards, forms, panels and default inputs.",
            "$extensions": { "ictAtlas": { "cssVariable": "--surface", "tailwindClass": "bg-surface" } }
          },
          "elevated": {
            "$type": "color",
            "$value": "{color.palette.shared.elevated}",
            "$extensions": { "ictAtlas": { "cssVariable": "--elevated", "tailwindClass": "bg-elevated" } }
          },
          "code": {
            "$type": "color",
            "$value": "{color.palette.shared.elevated}",
            "$description": "Dark code surface in both themes.",
            "$extensions": { "ictAtlas": { "cssVariable": "--code-surface", "tailwindClass": "bg-code-surface" } }
          }
        },
        "surface": {
          "default": { "$type": "color", "$value": "{color.palette.light.surface}", "$extensions": { "ictAtlas": { "cssVariable": "--surface" } } },
          "selected": { "$type": "color", "$value": "{color.palette.light.tealTint}", "$extensions": { "ictAtlas": { "cssVariable": "--surface-selected", "tailwindClass": "bg-teal-tint" } } },
          "hover": { "$type": "color", "$value": "{color.palette.light.canvas}", "$description": "Subtle hover surface for neutral controls on a white surface.", "$extensions": { "ictAtlas": { "cssVariable": "--surface-hover" } } }
        },
        "text": {
          "primary": { "$type": "color", "$value": "{color.palette.light.ink}", "$extensions": { "ictAtlas": { "cssVariable": "--ink", "tailwindClass": "text-ink" } } },
          "secondary": { "$type": "color", "$value": "{color.palette.light.muted}", "$description": "Use only when the actual size/weight or background meets contrast; not for normal-size copy on white.", "$extensions": { "ictAtlas": { "cssVariable": "--muted", "tailwindClass": "text-muted" } } },
          "secondaryStrong": { "$type": "color", "$value": "{color.palette.light.mutedStrong}", "$description": "Default secondary text for body-size copy on light surfaces.", "$extensions": { "ictAtlas": { "cssVariable": "--muted-strong", "tailwindClass": "text-muted-strong" } } },
          "onPrimary": { "$type": "color", "$value": "{color.palette.light.surface}", "$extensions": { "ictAtlas": { "cssVariable": "--action-primary-foreground", "tailwindClass": "text-on-primary" } } },
          "onDestructive": { "$type": "color", "$value": "{color.palette.light.surface}", "$extensions": { "ictAtlas": { "cssVariable": "--action-destructive-foreground", "tailwindClass": "text-on-destructive" } } },
          "onAccent": { "$type": "color", "$value": "{color.palette.light.ink}", "$description": "Use this same dark-ink foreground on the shared Accent color in both themes.", "$extensions": { "ictAtlas": { "cssVariable": "--text-on-accent" } } },
          "code": { "$type": "color", "$value": "{color.palette.shared.codeInk}", "$extensions": { "ictAtlas": { "cssVariable": "--code-ink", "tailwindClass": "text-code-ink" } } }
        },
        "border": {
          "subtle": { "$type": "color", "$value": "{color.palette.light.border}", "$description": "Passive separators; do not rely on this low-contrast color alone to identify an interactive control.", "$extensions": { "ictAtlas": { "cssVariable": "--border", "tailwindClass": "border-border" } } },
          "control": { "$type": "color", "$value": "{color.palette.light.mutedStrong}", "$description": "Accessible control boundary when a visible border is needed to identify the control.", "$extensions": { "ictAtlas": { "cssVariable": "--border-control" } } },
          "focus": { "$type": "color", "$value": "{color.palette.light.teal}", "$extensions": { "ictAtlas": { "cssVariable": "--focus", "tailwindClass": "outline-focus" } } },
          "selected": { "$type": "color", "$value": "{color.palette.light.teal}", "$extensions": { "ictAtlas": { "cssVariable": "--border-selected" } } }
        },
        "action": {
          "primary": {
            "background": { "$type": "color", "$value": "{color.palette.light.teal}", "$extensions": { "ictAtlas": { "cssVariable": "--action-primary-background", "tailwindClass": "bg-teal" } } },
            "foreground": { "$type": "color", "$value": "{color.palette.light.surface}", "$extensions": { "ictAtlas": { "cssVariable": "--action-primary-foreground" } } },
            "disabledBackground": { "$type": "color", "$value": "{color.palette.light.surface}" },
            "disabledForeground": { "$type": "color", "$value": "{color.palette.light.mutedStrong}" }
          },
          "secondary": {
            "background": { "$type": "color", "$value": "{color.palette.light.surface}" },
            "foreground": { "$type": "color", "$value": "{color.palette.light.ink}" },
            "border": { "$type": "color", "$value": "{color.palette.light.border}" },
            "hoverBackground": { "$type": "color", "$value": "{color.palette.light.canvas}" }
          },
          "tertiary": {
            "background": { "$type": "color", "$value": "transparent" },
            "foreground": { "$type": "color", "$value": "{color.palette.light.ink}" },
            "hoverBackground": { "$type": "color", "$value": "{color.palette.light.canvas}" }
          },
          "ghost": {
            "background": { "$type": "color", "$value": "transparent" },
            "foreground": { "$type": "color", "$value": "{color.palette.light.ink}" },
            "hoverBackground": { "$type": "color", "$value": "{color.palette.light.canvas}" }
          },
          "destructive": {
            "background": { "$type": "color", "$value": "{color.palette.light.red}" },
            "foreground": { "$type": "color", "$value": "{color.palette.light.surface}" },
            "disabledBackground": { "$type": "color", "$value": "{color.palette.light.surface}" },
            "disabledForeground": { "$type": "color", "$value": "{color.palette.light.mutedStrong}" }
          }
        },
        "state": {
          "selected": {
            "background": { "$type": "color", "$value": "{color.palette.light.tealTint}" },
            "foreground": { "$type": "color", "$value": "{color.palette.light.teal}" },
            "border": { "$type": "color", "$value": "{color.palette.light.teal}" }
          },
          "success": {
            "background": { "$type": "color", "$value": "{color.palette.light.tealTint}" },
            "foreground": { "$type": "color", "$value": "{color.palette.light.teal}" },
            "bodyText": { "$type": "color", "$value": "{color.palette.light.ink}" },
            "border": { "$type": "color", "$value": "{color.palette.light.teal}" }
          },
          "warning": {
            "background": { "$type": "color", "$value": "{color.palette.light.surface}" },
            "foreground": { "$type": "color", "$value": "{color.palette.light.amber}", "$description": "Icon, badge and qualifying large-text color only on light surfaces; pair normal-size warning copy with Ink." },
            "bodyText": { "$type": "color", "$value": "{color.palette.light.ink}" },
            "border": { "$type": "color", "$value": "{color.palette.light.amber}" }
          },
          "error": {
            "background": { "$type": "color", "$value": "{color.palette.light.surface}" },
            "foreground": { "$type": "color", "$value": "{color.palette.light.red}" },
            "bodyText": { "$type": "color", "$value": "{color.palette.light.ink}" },
            "border": { "$type": "color", "$value": "{color.palette.light.red}" }
          },
          "information": {
            "background": { "$type": "color", "$value": "{color.palette.light.surface}" },
            "foreground": { "$type": "color", "$value": "{color.palette.light.ink}" },
            "icon": { "$type": "color", "$value": "{color.palette.light.mutedStrong}" },
            "border": { "$type": "color", "$value": "{color.palette.light.border}" },
            "$description": "Neutral-first; no additional blue information hue is introduced. Label and icon identify the message."
          }
        }
      },
      "dark": {
        "background": {
          "canvas": { "$type": "color", "$value": "{color.palette.dark.canvas}", "$extensions": { "ictAtlas": { "cssVariable": "--canvas", "tailwindClass": "bg-canvas" } } },
          "surface": { "$type": "color", "$value": "{color.palette.dark.surface}", "$extensions": { "ictAtlas": { "cssVariable": "--surface", "tailwindClass": "bg-surface" } } },
          "elevated": { "$type": "color", "$value": "{color.palette.shared.elevated}", "$extensions": { "ictAtlas": { "cssVariable": "--elevated", "tailwindClass": "bg-elevated" } } },
          "code": { "$type": "color", "$value": "{color.palette.shared.elevated}", "$extensions": { "ictAtlas": { "cssVariable": "--code-surface", "tailwindClass": "bg-code-surface" } } }
        },
        "surface": {
          "default": { "$type": "color", "$value": "{color.palette.dark.surface}", "$extensions": { "ictAtlas": { "cssVariable": "--surface" } } },
          "selected": { "$type": "color", "$value": "{color.palette.dark.tealTint}", "$extensions": { "ictAtlas": { "cssVariable": "--surface-selected", "tailwindClass": "bg-teal-tint" } } },
          "hover": { "$type": "color", "$value": "{color.palette.shared.elevated}", "$description": "Tonal hover/elevated surface in dark theme.", "$extensions": { "ictAtlas": { "cssVariable": "--surface-hover" } } }
        },
        "text": {
          "primary": { "$type": "color", "$value": "{color.palette.dark.ink}", "$extensions": { "ictAtlas": { "cssVariable": "--ink", "tailwindClass": "text-ink" } } },
          "secondary": { "$type": "color", "$value": "{color.palette.dark.muted}", "$extensions": { "ictAtlas": { "cssVariable": "--muted", "tailwindClass": "text-muted" } } },
          "secondaryStrong": { "$type": "color", "$value": "{color.palette.dark.muted}", "$extensions": { "ictAtlas": { "cssVariable": "--muted-strong", "tailwindClass": "text-muted-strong" } } },
          "onPrimary": { "$type": "color", "$value": "{color.palette.dark.ink}", "$description": "Mirrors README §17.8. This Ink-on-Teal pair is approximately 2.17:1 and fails normal-text AA; block implementation until the owner approves a contrast-safe mapping. Existing dark Canvas is a candidate, not an approved replacement.", "$extensions": { "ictAtlas": { "cssVariable": "--action-primary-foreground", "tailwindClass": "text-on-primary" } } },
          "onDestructive": { "$type": "color", "$value": "{color.palette.dark.canvas}", "$extensions": { "ictAtlas": { "cssVariable": "--action-destructive-foreground", "tailwindClass": "text-on-destructive" } } },
          "onAccent": { "$type": "color", "$value": "{color.palette.light.ink}", "$description": "Use dark Ink on the shared pale Accent in both themes.", "$extensions": { "ictAtlas": { "cssVariable": "--text-on-accent" } } },
          "code": { "$type": "color", "$value": "{color.palette.shared.codeInk}", "$extensions": { "ictAtlas": { "cssVariable": "--code-ink", "tailwindClass": "text-code-ink" } } }
        },
        "border": {
          "subtle": { "$type": "color", "$value": "{color.palette.dark.border}", "$description": "Passive separators; do not rely on this low-contrast color alone to identify an interactive control.", "$extensions": { "ictAtlas": { "cssVariable": "--border", "tailwindClass": "border-border" } } },
          "control": { "$type": "color", "$value": "{color.palette.dark.muted}", "$description": "Accessible control boundary when a visible border is needed to identify the control.", "$extensions": { "ictAtlas": { "cssVariable": "--border-control" } } },
          "focus": { "$type": "color", "$value": "{color.palette.dark.teal}", "$extensions": { "ictAtlas": { "cssVariable": "--focus", "tailwindClass": "outline-focus" } } },
          "selected": { "$type": "color", "$value": "{color.palette.dark.teal}", "$extensions": { "ictAtlas": { "cssVariable": "--border-selected" } } }
        },
        "action": {
          "primary": {
            "background": { "$type": "color", "$value": "{color.palette.dark.teal}", "$extensions": { "ictAtlas": { "cssVariable": "--action-primary-background", "tailwindClass": "bg-teal" } } },
            "foreground": { "$type": "color", "$value": "{color.palette.dark.ink}", "$description": "Mirrors README §17.8, but the pair is approximately 2.17:1 and fails normal-text AA. Do not ship in Dark until the owner resolves the contrast conflict; dark Canvas is a palette-safe candidate requiring approval.", "$extensions": { "ictAtlas": { "cssVariable": "--action-primary-foreground" } } },
            "disabledBackground": { "$type": "color", "$value": "{color.palette.dark.surface}" },
            "disabledForeground": { "$type": "color", "$value": "{color.palette.dark.muted}" }
          },
          "secondary": {
            "background": { "$type": "color", "$value": "{color.palette.dark.surface}" },
            "foreground": { "$type": "color", "$value": "{color.palette.dark.ink}" },
            "border": { "$type": "color", "$value": "{color.palette.dark.border}" },
            "hoverBackground": { "$type": "color", "$value": "{color.palette.shared.elevated}" }
          },
          "tertiary": {
            "background": { "$type": "color", "$value": "transparent" },
            "foreground": { "$type": "color", "$value": "{color.palette.dark.ink}" },
            "hoverBackground": { "$type": "color", "$value": "{color.palette.shared.elevated}" }
          },
          "ghost": {
            "background": { "$type": "color", "$value": "transparent" },
            "foreground": { "$type": "color", "$value": "{color.palette.dark.ink}" },
            "hoverBackground": { "$type": "color", "$value": "{color.palette.shared.elevated}" }
          },
          "destructive": {
            "background": { "$type": "color", "$value": "{color.palette.dark.red}" },
            "foreground": { "$type": "color", "$value": "{color.palette.dark.canvas}" },
            "disabledBackground": { "$type": "color", "$value": "{color.palette.dark.surface}" },
            "disabledForeground": { "$type": "color", "$value": "{color.palette.dark.muted}" }
          }
        },
        "state": {
          "selected": {
            "background": { "$type": "color", "$value": "{color.palette.dark.tealTint}" },
            "foreground": { "$type": "color", "$value": "{color.palette.dark.teal}" },
            "border": { "$type": "color", "$value": "{color.palette.dark.teal}" }
          },
          "success": {
            "background": { "$type": "color", "$value": "{color.palette.dark.tealTint}" },
            "foreground": { "$type": "color", "$value": "{color.palette.dark.teal}" },
            "bodyText": { "$type": "color", "$value": "{color.palette.dark.ink}" },
            "border": { "$type": "color", "$value": "{color.palette.dark.teal}" }
          },
          "warning": {
            "background": { "$type": "color", "$value": "{color.palette.dark.surface}" },
            "foreground": { "$type": "color", "$value": "{color.palette.dark.amber}" },
            "bodyText": { "$type": "color", "$value": "{color.palette.dark.ink}" },
            "border": { "$type": "color", "$value": "{color.palette.dark.amber}" }
          },
          "error": {
            "background": { "$type": "color", "$value": "{color.palette.dark.surface}" },
            "foreground": { "$type": "color", "$value": "{color.palette.dark.red}" },
            "bodyText": { "$type": "color", "$value": "{color.palette.dark.ink}" },
            "border": { "$type": "color", "$value": "{color.palette.dark.red}" }
          },
          "information": {
            "background": { "$type": "color", "$value": "{color.palette.dark.surface}" },
            "foreground": { "$type": "color", "$value": "{color.palette.dark.ink}" },
            "icon": { "$type": "color", "$value": "{color.palette.dark.muted}" },
            "border": { "$type": "color", "$value": "{color.palette.dark.border}" },
            "$description": "Neutral-first; no additional blue information hue is introduced. Label and icon identify the message."
          }
        }
      }
    }
  },
  "typography": {
    "fontFamily": {
      "sans": {
        "$type": "fontFamily",
        "$value": ["Geist Sans", "SolaimanLipi", "Noto Sans Bengali", "system-ui", "sans-serif"],
        "$extensions": { "ictAtlas": { "cssVariable": "--font-sans", "tailwindClass": "font-sans" } }
      },
      "bengali": {
        "$type": "fontFamily",
        "$value": ["SolaimanLipi", "Noto Sans Bengali", "sans-serif"],
        "$description": "Apply only to Bengali language runs; not the global Latin body face.",
        "$extensions": { "ictAtlas": { "cssVariable": "--font-bengali", "tailwindClass": "font-bn" } }
      },
      "mono": {
        "$type": "fontFamily",
        "$value": ["Geist Mono", "ui-monospace", "monospace"],
        "$extensions": { "ictAtlas": { "cssVariable": "--font-mono", "tailwindClass": "font-mono" } }
      },
      "math": {
        "$type": "fontFamily",
        "$value": ["KaTeX_Main", "KaTeX_Math", "KaTeX_AMS", "serif"],
        "$description": "Use KaTeX's own stack and its accessible text/LaTeX fallback; never substitute Bengali UI metrics."
      }
    },
    "weight": {
      "regular": { "$type": "fontWeight", "$value": 400 },
      "medium": { "$type": "fontWeight", "$value": 500 },
      "display": { "$type": "fontWeight", "$value": 450 },
      "heading": { "$type": "fontWeight", "$value": 550 },
      "strongHeading": { "$type": "fontWeight", "$value": 600 },
      "bengaliBold": { "$type": "fontWeight", "$value": 700 }
    },
    "scale": {
      "display": { "fontSize": "clamp(40px, 6vw, 64px)", "fontWeight": 450, "lineHeight": 1.1, "letterSpacing": "-0.03em", "usage": "Marketing hero only; 64px desktop maximum, 40px mobile minimum." },
      "h1": { "fontSize": "40px", "fontWeight": 550, "lineHeight": 1.2, "letterSpacing": "-0.03em", "usage": "Page title; one per page." },
      "h2": { "fontSize": "28px", "fontWeight": 550, "lineHeight": 1.25, "letterSpacing": "-0.02em" },
      "h3": { "fontSize": "20px", "fontWeight": 550, "lineHeight": 1.35, "letterSpacing": "-0.02em" },
      "h4": { "fontSize": "16px", "fontWeight": 600, "lineHeight": 1.4 },
      "h5": { "fontSize": "14px", "fontWeight": 600, "lineHeight": 1.5, "usage": "Derived heading level using the existing Body size; no new type size." },
      "h6": { "fontSize": "12px", "fontWeight": 600, "lineHeight": 1.5, "usage": "Derived dense heading level using the existing Small size; do not use for reading content." },
      "body": { "fontSize": "14px", "fontWeight": 400, "lineHeightLatin": 1.5, "lineHeightBengaliMinimum": 1.75 },
      "reading": { "fontSize": "16px", "fontWeight": 400, "lineHeightLatin": 1.6, "lineHeightBengaliMinimum": 1.75, "usage": "Preferred long-form question/explanation reading size where layout permits." },
      "small": { "fontSize": "12px", "fontWeight": 400, "lineHeight": 1.5 },
      "label": { "fontSize": "12px", "fontWeight": 500, "lineHeight": 1.4 },
      "button": { "fontSize": "14px", "fontWeight": 500, "lineHeight": 1.4 },
      "caption": { "fontSize": "12px", "fontWeight": 400, "lineHeight": 1.5 },
      "micro": { "fontSize": "11px", "fontWeight": 500, "lineHeight": 1.4 },
      "code": { "fontSize": "13px", "fontWeight": 400, "lineHeight": 1.6 }
    },
    "rules": {
      "rootSize": "16px",
      "bengaliLineHeightMinimum": 1.75,
      "mobileInputFontSizeMinimum": "16px",
      "questionTextMinimum": "14px",
      "mobileDisplayMinimum": "40px",
      "bengaliJustification": "Never justify Bengali paragraphs.",
      "fontDisplay": "swap"
    }
  },
  "spacing": {
    "baseUnit": "4px",
    "scale": {
      "0": "0px",
      "1": "4px",
      "2": "8px",
      "3": "12px",
      "4": "16px",
      "6": "24px",
      "8": "32px",
      "10": "40px",
      "12": "48px"
    }
  },
  "geometry": {
    "radius": {
      "none": "0px",
      "micro": "4px",
      "control": "8px",
      "card": "10px",
      "cardLarge": "12px",
      "dialog": "14px",
      "section": "16px",
      "sectionLarge": "20px",
      "circle": "9999px"
    },
    "borderWidth": {
      "hairline": "1px",
      "focus": "2px",
      "focusOffset": "2px",
      "activeNavigationIndicator": "3px"
    },
    "controlHeight": {
      "button": { "small": "36px", "medium": "38px", "large": "40px" },
      "field": { "small": "38px", "medium": "40px", "large": "42px" },
      "touchTargetMinimum": "44px",
      "mobileFieldMinimum": "44px",
      "iconButtonHitArea": "44px"
    },
    "iconSize": { "small": "16px", "medium": "20px", "large": "24px" },
    "avatarSize": { "small": "24px", "medium": "32px", "large": "40px" },
    "dialogMaxWidth": { "small": "400px", "medium": "560px", "large": "720px" },
    "drawerMaxWidth": { "small": "320px", "medium": "400px", "large": "560px", "mobile": "100vw" }
  },
  "elevation": {
    "principle": "Borders before shadows; no card shadow by default; dark elevation is primarily tonal.",
    "shadow": {
      "none": "none",
      "popoverLight": "0 2px 8px rgb(23 25 27 / 0.08)",
      "dialogLight": "0 8px 24px rgb(23 25 27 / 0.10)",
      "dragLight": "0 8px 20px rgb(23 25 27 / 0.12)",
      "popoverDark": "0 2px 8px rgb(9 11 13 / 0.16)",
      "dialogDark": "0 8px 24px rgb(9 11 13 / 0.20)",
      "dragDark": "0 8px 20px rgb(9 11 13 / 0.22)"
    }
  },
  "layout": {
    "referenceViewport": {
      "desktop": { "width": "1440px", "height": "1000px" },
      "mobile": { "width": "390px", "height": "844px" }
    },
    "containerMaxWidth": {
      "publicWebsite": "1200px",
      "applicationShell": "1440px"
    },
    "grid": {
      "desktop": { "columns": 12, "gutter": "24px" },
      "tablet": { "columns": 8, "gutter": "16px" },
      "mobile": { "columns": 4, "gutter": "16px" },
      "narrowMobile": { "columns": 4, "gutter": "12px" }
    },
    "contentPadding": {
      "narrowMobile": "16px",
      "mobile": "16px",
      "tablet": "24px",
      "desktop": "32px",
      "largeDesktop": "40px"
    },
