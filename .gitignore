# dependencies
/node_modules
/.pnp
.pnp.*

# testing
/coverage
/test-results
/playwright-report
/playwright/.cache

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — never commit secrets; commit only .env.example
.env
.env.*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# prisma
/prisma/*.db
/prisma/*.db-journal

# generated code (regenerate with: npm run db:generate)
/lib/generated/

# G-1 spike run artefacts — regenerated by docs/database/g1-spike/run.sh
/docs/database/g1-spike/out/
/docs/database/g1-spike/experiment-2/out/
/docs/database/g1-spike/option-c/out/
/docs/database/g1-spike/option-c/g3/out/
/docs/database/g1-spike/option-c/g3-full/out/
/docs/database/g1-spike/option-c/g3-full/out-local/

# Python bytecode from the G-3 guard
__pycache__/
*.pyc

# V-1 verification driver: scratch session directory.
# It must live inside the repository so Node can resolve `prisma/config` from the
# generated config files, but nothing in it should ever be committed.
/.v1-session/
