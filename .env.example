# ICT Atlas — environment variable template
# Copy to .env.local for development (git-ignored). Placeholders only — never
# commit real credentials. See README Appendix B and docs/deployment/environments.md.
#
# Prefix rules: NEXT_PUBLIC_* is inlined into the browser bundle. AI keys,
# the Supabase service-role key and the PDF worker token must NEVER carry it.

# ── Database ─────────────────────────────────────────────────────────────
# Server-only.
# DATABASE_URL — the application's runtime connection (lib/db.ts). On Supabase
#   this is the TRANSACTION POOLER, port 6543, e.g.
#   postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
# DIRECT_URL — used by Prisma migrations (prisma.config.ts) and the deploy gate
#   (scripts/db/deploy-gate.sh). On Supabase this is the DIRECT or SESSION
#   connection, port 5432 — migrations must not go through the transaction pooler.
#   If unset, migrations fall back to DATABASE_URL (fine locally, where both are
#   the same database).
DATABASE_URL="postgresql://postgres:password@localhost:5432/ict_atlas"
DIRECT_URL="postgresql://postgres:password@localhost:5432/ict_atlas"

# ── Supabase ─────────────────────────────────────────────────────────────
# Public values (safe for the browser; RLS + server authorization still apply).
NEXT_PUBLIC_SUPABASE_URL="https://your-project-ref.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"
# Server-only — never expose to the browser or commit real values.
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# ── AI (server-only; adapter pattern, README §4.4) ───────────────────────
AI_PROVIDER="gemini"
GEMINI_API_KEY="your-gemini-api-key"
GEMINI_MODEL="gemini-2.5-flash"
AI_TUTOR_DAILY_LIMIT="100"
AI_TUTOR_HOURLY_LIMIT="20"

# ── Rate limiting (optional until traffic justifies it — README O6) ──────
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# ── PDF worker (README §7.5.3; host open — OD-02) ────────────────────────
PDF_WORKER_URL=""
PDF_WORKER_TOKEN=""
PDF_RENDER_TIMEOUT_MS="30000"
EXAM_GRACE_WINDOW_MS="5000"

# ── Application ──────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"
